(version 1)
(deny default)
(allow process-info* (target self))
(allow signal (target same-sandbox))
(allow sysctl-read)
(allow file-read* (subpath "/System/Library") (subpath "/usr/lib") (subpath "/private/var/db/dyld") (subpath "/private/var/db/timezone") (literal "/dev/null") (literal "/dev/random") (literal "/dev/urandom"))
(allow file-write-data (literal "/dev/null"))
(allow process-exec (literal (param "BIN")))
(allow file-read* (literal (param "BIN")) (literal (param "SPEC")))
; Renderer emits exact ancestor file-read-metadata literals for all inputs. No global metadata grant.
; @@ANCESTOR_METADATA_LITERALS@@
(allow file-read* (literal (param "PARSER")) (literal (param "WORKER")) (subpath (param "PYROOT")) (literal "/opt/homebrew/opt/gettext/lib/libintl.8.dylib") (literal "/opt/homebrew/Cellar/gettext/1.0/lib/libintl.8.dylib"))
; @@APPROVED_INPUT_READ_LITERALS@@
; @@EXACT_WRITE_TARGET_AND_SWAP@@ only for write operation, omitted for read and all verifiers.
; Parent metadata only, except the exact parent directory fsync permission required by atomic replace.
; No network, mach, process-fork or extra process-exec rules.

; PROPOSED ONLY: bounded OS-loader diagnostic, not approved or active.
(allow file-read-metadata (literal "/") (literal "/System") (literal "/System/Cryptexes") (literal "/System/Cryptexes/OS") (literal "/System/Cryptexes/OS/System") (literal "/System/Cryptexes/OS/System/Library") (literal "/System/Cryptexes/OS/System/Library/dyld") (literal "/System/Volumes") (literal "/System/Volumes/Preboot") (literal "/System/Volumes/Preboot/Cryptexes") (literal "/System/Volumes/Preboot/Cryptexes/OS") (literal "/System/Volumes/Preboot/Cryptexes/OS/System") (literal "/System/Volumes/Preboot/Cryptexes/OS/System/Library") (literal "/System/Volumes/Preboot/Cryptexes/OS/System/Library/dyld"))
(allow file-read-data (literal "/System/Cryptexes/OS/System/Library/dyld/dyld_shared_cache_arm64e") (literal "/System/Cryptexes/OS/System/Library/dyld/dyld_shared_cache_arm64e.01") (literal "/System/Cryptexes/OS/System/Library/dyld/dyld_shared_cache_arm64e.02") (literal "/System/Cryptexes/OS/System/Library/dyld/dyld_shared_cache_arm64e.03") (literal "/System/Cryptexes/OS/System/Library/dyld/dyld_shared_cache_arm64e.04") (literal "/System/Cryptexes/OS/System/Library/dyld/dyld_shared_cache_arm64e.05") (literal "/System/Cryptexes/OS/System/Library/dyld/dyld_shared_cache_arm64e.06") (literal "/System/Cryptexes/OS/System/Library/dyld/dyld_shared_cache_arm64e.07") (literal "/System/Cryptexes/OS/System/Library/dyld/dyld_shared_cache_arm64e.08") (literal "/System/Cryptexes/OS/System/Library/dyld/dyld_shared_cache_arm64e.09") (literal "/System/Cryptexes/OS/System/Library/dyld/dyld_shared_cache_arm64e.10") (literal "/System/Cryptexes/OS/System/Library/dyld/dyld_shared_cache_arm64e.11") (literal "/System/Cryptexes/OS/System/Library/dyld/dyld_shared_cache_arm64e.12") (literal "/System/Cryptexes/OS/System/Library/dyld/dyld_shared_cache_arm64e.13") (literal "/System/Cryptexes/OS/System/Library/dyld/dyld_shared_cache_arm64e.14") (literal "/System/Cryptexes/OS/System/Library/dyld/dyld_shared_cache_arm64e.15") (literal "/System/Cryptexes/OS/System/Library/dyld/dyld_shared_cache_arm64e.16") (literal "/System/Cryptexes/OS/System/Library/dyld/dyld_shared_cache_arm64e.17") (literal "/System/Cryptexes/OS/System/Library/dyld/dyld_shared_cache_arm64e.18") (literal "/System/Cryptexes/OS/System/Library/dyld/dyld_shared_cache_arm64e.19") (literal "/System/Cryptexes/OS/System/Library/dyld/dyld_shared_cache_arm64e.20") (literal "/System/Cryptexes/OS/System/Library/dyld/dyld_shared_cache_arm64e.21") (literal "/System/Cryptexes/OS/System/Library/dyld/dyld_shared_cache_arm64e.22") (literal "/System/Cryptexes/OS/System/Library/dyld/dyld_shared_cache_arm64e.23") (literal "/System/Cryptexes/OS/System