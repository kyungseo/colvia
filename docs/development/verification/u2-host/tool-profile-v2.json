[
  {
    "type": "function",
    "name": "u2_read_file",
    "description": "승인된 파일 ID의 고정 원문 또는 지정 구간을 읽습니다. sha256은 반환 본문, file_sha256은 전체 파일의 CAS 값이며 absent 상태의 file_sha256은 null입니다.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "file_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        }
      },
      "required": [
        "file_ids"
      ],
      "additionalProperties": false
    }
  },
  {
    "type": "function",
    "name": "u2_write_file",
    "description": "승인된 파일의 file_sha256 대조 후 원문 또는 고정 편집 구간을 교체합니다. 새 파일은 expected_sha256=null이고 경로가 여전히 없을 때만 생성합니다. 경로·구간은 선택할 수 없습니다.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "file_id": {
          "type": "string"
        },
        "expected_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "content": {
          "type": "string"
        }
      },
      "required": [
        "file_id",
        "expected_sha256",
        "content"
      ],
      "additionalProperties": false
    }
  },
  {
    "type": "function",
    "name": "u2_verify",
    "description": "고정 문서 검증기 한 개를 실행합니다.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "verifier_id": {
          "enum": [
            "DOC-LINKS",
            "DOC-GFM",
            "DOC-CLAIMS"
          ]
        }
      },
      "required": [
        "verifier_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "type": "function",
    "name": "u2_accept",
    "description": "봉인된 결과의 사전 승인된 수락 handle 한 개를 요청합니다.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "handle": {
          "type": "string"
        }
      },
      "required": [
        "handle"
      ],
      "additionalProperties": false
    }
  }
]
