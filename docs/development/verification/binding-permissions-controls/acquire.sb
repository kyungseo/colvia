(version 1)
; Authoring draft: compilation/effective isolation still requires approved execution.
(deny default)
(allow process-exec process-fork)
(allow signal (target same-sandbox))
(allow sysctl-read)
(allow process-info* (target self))
(allow file-ioctl (subpath (param "WORK")))
; Host metadata is intentionally visible. This is not whole-host confidentiality.
(allow file-read-metadata)
; Owner-approved root-directory read for the observed startup denial.
; Literal / exposes root entry names, not recursive descendant file contents.
(allow file-read-data (literal "/"))
(allow file-read* (subpath "/System") (subpath "/usr") (subpath "/bin") (subpath "/sbin")
  (subpath "/Library/Developer/CommandLineTools") (subpath "/Library/Apple")
  (subpath "/opt/homebrew/Cellar") (subpath "/opt/homebrew/opt")
  (subpath "/private/var/db/dyld") (subpath "/private/var/db/timezone"))
(allow file-read* (subpath (param "SOURCE")) (subpath (param "OLD"))
  (subpath (param "CONTROLS")) (subpath (param "WORK"))
  (subpath (param "PREDECESSOR")) (subpath (param "ARTIFACTS"))
  (literal (param "INPUT")) (literal (param "BOUNDARY")))
(allow file-read-data (literal "/dev/fd") (literal "/dev/null")
  (literal "/dev/random") (literal "/dev/urandom"))
(allow file-write* (subpath (param "WORK")) (literal "/dev/null"))
; Pre-opened stdout is untrusted child diagnostics; no parent gate uses it.
(allow file-write-data (literal (param "LOG")))
; No other ancestor readdir, parent evidence writes, network/keychain lookup or user config.
; Acquisition alone reads source objects and populates absent OLD.
; Source repository config/refs/HEAD/hooks remain outside read allowance.
(allow file-read* (subpath (param "OBJECTS")))
(allow file-write* (subpath (param "OLD")))
