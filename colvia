#!/usr/bin/env -S python3 -I -B
from __future__ import annotations

WORKSPACE_INVENTORY_ID = "continuation-1"

import hashlib
import json
import re
import stat
import sys
from pathlib import Path


def fail(code: str, message: str) -> int:
    print(json.dumps({"classification": "fail", "code": code, "message": message}, sort_keys=True))
    return 65


def regular_bytes(path: Path) -> bytes:
    for parent in reversed(path.parents):
        observed = parent.lstat()
        if (not stat.S_ISDIR(observed.st_mode)
                or (WORKSPACE_INVENTORY_ID == "windows-2" and getattr(observed, "st_file_attributes", 0) & 0x400)):
            raise ValueError("non-directory launcher ancestor")
    before = path.lstat()
    if (not stat.S_ISREG(before.st_mode) or before.st_nlink != 1
            or (WORKSPACE_INVENTORY_ID == "windows-2" and getattr(before, "st_file_attributes", 0) & 0x400)):
        raise ValueError("non-regular or shared launcher input")
    data = path.read_bytes()
    after = path.lstat()
    if (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns, before.st_ctime_ns) != (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns, after.st_ctime_ns):
        raise ValueError("unstable launcher input")
    return data


def json_file(path: Path):
    data = regular_bytes(path)
    if len(data) > 4 * 1024 * 1024:
        raise ValueError("oversized bootstrap JSON")
    def pairs(items):
        result = {}
        for key, value in items:
            if key in result: raise ValueError("duplicate bootstrap key")
            result[key] = value
        return result
    value = json.loads(data, object_pairs_hook=pairs, parse_constant=lambda value: (_ for _ in ()).throw(ValueError("nonfinite JSON")))
    if (json.dumps(value, ensure_ascii=False, sort_keys=True, indent=2, allow_nan=False) + "\n").encode() != data:
        raise ValueError("noncanonical bootstrap JSON")
    return value, data


def workspace_source(root: Path) -> Path:
    if not sys.flags.isolated or not sys.dont_write_bytecode:
        raise ValueError("workspace launcher requires isolated Python and no bytecode")
    binding, _ = json_file(root / ".hrn/product/binding.json")
    ref = binding["active_release"]
    rid = ref["id"]
    if not isinstance(rid, str) or re.fullmatch(r"product-release-[0-9a-f]{24}", rid) is None:
        raise ValueError("invalid bound release id")
    release = root / ".hrn/product/releases" / rid
    inventory, raw = json_file(release / "inventory.json")
    digest = hashlib.sha256(raw).hexdigest()
    if rid != "product-release-" + digest[:24] or ref != {"id": rid, "sha256": digest, "inventory_id": WORKSPACE_INVENTORY_ID}:
        raise ValueError("release reference mismatch")
    if not isinstance(inventory, dict) or inventory.get("record_type") != "release-inventory" or type(inventory.get("schema_version")) is not int or inventory["schema_version"] != 1 or inventory.get("inventory_id") != WORKSPACE_INVENTORY_ID:
        raise ValueError("unsupported inventory")
    entries = {}
    for entry in inventory["entries"]:
        name = entry["path"]
        if not isinstance(name, str) or name in entries: raise ValueError("duplicate or invalid inventory path")
        entries[name] = entry
    # Validate every importable module before any package code executes. Full
    # product/record verification still belongs to the imported readers/guards.
    modules = ("__init__", "candidates", "cli", "continuation", "errors", "intent", "jsonio", "product", "umbrella", "view", "work", "workspace")
    if WORKSPACE_INVENTORY_ID == "official-execution-1":
        modules += ('official_adapter', 'official_admission', 'official_documents', 'official_entry', 'official_host', 'official_os', 'official_policy', 'official_state', 'official_worker')
    expected = {"src/hv2ref/" + name + ".py" for name in modules}
    package = release / "payload/src/hv2ref"
    for directory in reversed((package, *package.parents)):
        observed = directory.lstat()
        if (not stat.S_ISDIR(observed.st_mode)
                or (WORKSPACE_INVENTORY_ID == "windows-2" and getattr(observed, "st_file_attributes", 0) & 0x400)):
            raise ValueError("unsafe package directory")
    if {p.name for p in package.parent.iterdir()} != {"hv2ref"}:
        raise ValueError("unexpected import root member")
    if {p.name for p in package.iterdir()} != {name + ".py" for name in modules}:
        raise ValueError("unexpected importable package member")
    for name in sorted(expected | {"colvia"}):
        entry = entries[name]
        data = regular_bytes(release / "payload" / name)
        if type(entry["size_bytes"]) is not int or entry["size_bytes"] != len(data) or entry["sha256"] != hashlib.sha256(data).hexdigest():
            raise ValueError("bootstrap payload mismatch")
        if name == "colvia" and data != regular_bytes(root / "colvia"):
            raise ValueError("launcher differs from bound release")
    return release / "payload/src"


def windows_runtime_observation() -> dict:
    """Observe the actual Windows client and process pair, never just a profile."""
    result = {"supported": False, "classification": "unsupported", "platform": sys.platform}
    if sys.platform != "win32":
        result["reason"] = "windows-2 requires native Windows"
        return result
    try:
        import ctypes as C
        from ctypes import wintypes as W
        import sysconfig
        kernel = C.WinDLL("kernel32", use_last_error=True)
        process = kernel.GetCurrentProcess
        process.argtypes, process.restype = [], W.HANDLE
        machine = kernel.IsWow64Process2
        machine.argtypes, machine.restype = [W.HANDLE, C.POINTER(W.USHORT), C.POINTER(W.USHORT)], W.BOOL
        process_machine, native_machine = W.USHORT(), W.USHORT()
        if not machine(process(), C.byref(process_machine), C.byref(native_machine)):
            raise C.WinError(C.get_last_error())
        class Version(C.Structure):
            _fields_ = [("size", W.DWORD), ("major", W.DWORD), ("minor", W.DWORD),
                        ("build", W.DWORD), ("platform", W.DWORD), ("service_pack", W.WCHAR * 128),
                        ("sp_major", W.WORD), ("sp_minor", W.WORD), ("suite", W.WORD),
                        ("product_type", W.BYTE), ("reserved", W.BYTE)]
        version = Version()
        version.size = C.sizeof(version)
        query = C.WinDLL("ntdll").RtlGetVersion
        query.argtypes, query.restype = [C.POINTER(Version)], W.LONG
        status = query(C.byref(version))
        if status != 0:
            result.update(classification="unknown", reason="RtlGetVersion failed", ntstatus=int(status))
            return result
        result.update(os_version=[version.major, version.minor, version.build],
                      product_type=int(version.product_type), process_machine=int(process_machine.value),
                      native_machine=int(native_machine.value), pointer_bits=C.sizeof(C.c_void_p) * 8,
                      implementation=sys.implementation.name, python=list(sys.version_info[:3]),
                      releaselevel=sys.version_info.releaselevel,
                      free_threaded=bool(sysconfig.get_config_var("Py_GIL_DISABLED")),
                      process_platform=sysconfig.get_platform())
        result["supported"] = (version.major == 10 and version.build >= 22000 and version.product_type == 1
                               and process_machine.value == 0
                               and {"win-amd64": 0x8664, "win-arm64": 0xAA64}.get(result["process_platform"]) == native_machine.value
                               and C.sizeof(C.c_void_p) == 8 and sys.implementation.name == "cpython"
                               and sys.version_info[:3] in {(3, 14, 6), (3, 14, 7)}
                               and sys.version_info.releaselevel == "final" and not result["free_threaded"])
        result["classification"] = "supported" if result["supported"] else "unsupported"
        result["reason"] = "native tuple admitted" if result["supported"] else "OS/process/Python tuple is outside windows-2 policy"
    except (AttributeError, OSError, ValueError) as exc:
        result.update(classification="unknown", reason=type(exc).__name__, winerror=getattr(exc, "winerror", None))
    return result


def main() -> int:
    if sys.platform == "win32":
        for stream in (sys.stdout, sys.stderr):
            stream.reconfigure(encoding="utf-8", errors="strict", newline="\n")
    if WORKSPACE_INVENTORY_ID == "windows-2":
        observed = windows_runtime_observation()
        if not observed["supported"]:
            print(json.dumps({"classification": observed["classification"], "code": "HV2-WORKSPACE-RUNTIME",
                              "message": observed["reason"], "runtime": observed}, sort_keys=True))
            return 16 if any(arg in {"status", "doctor", "view"} for arg in sys.argv[1:2]) else 65
        if not sys.flags.isolated or not sys.dont_write_bytecode:
            return fail("HV2-WORKSPACE-RUNTIME", "windows-2 requires explicit allowed Python -I -B")
    root = Path(__file__).absolute().parent
    workspace = root / ".hrn"
    try:
        if workspace.exists() or workspace.is_symlink():
            source = workspace_source(root)
            sys.path.insert(0, str(source))
            from hv2ref.cli import main as cli_main
            return cli_main(workspace_target=root)
        # Source entry is an explicit trusted operator mode.
        # Missing workspace metadata must never select project code implicitly.
        mode = sys.argv[1] if len(sys.argv) > 1 else None
        if mode != "--source-checkout":
            return fail("HV2-WORKSPACE-LAUNCHER", "missing .hrn; use an independent trusted source checkout for recovery")
        del sys.argv[1]
        source = root / "src"
        if source.is_symlink() or not (source / "hv2ref/cli.py").is_file():
            return fail("HV2-PRODUCT-LAUNCHER-SOURCE", str(source))
        sys.dont_write_bytecode = True
        sys.path.insert(0, str(source))
        from hv2ref.cli import main as cli_main
        return cli_main()
    except (KeyError, OSError, TypeError, ValueError, RecursionError):
        return fail("HV2-WORKSPACE-LAUNCHER", "invalid or unavailable binding/payload; a pending transition may require recovery from independent trusted source")


if __name__ == "__main__":
    raise SystemExit(main())
